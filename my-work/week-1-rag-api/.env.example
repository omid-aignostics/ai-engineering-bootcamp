# Session 1 — answers come from Claude
ANTHROPIC_API_KEY=

# Session 2 — RAG: Pinecone stores the documents and embeds them itself (llama-text-embed-v2)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ask-rag
# Optional: keep different document sets apart inside one index (empty = "default")
PINECONE_NAMESPACE=

# Admin key for POST /ingest (send it as the X-Admin-Key header). Without it, /ingest is off.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=

# Access key for /ask, /agent, /agent/confirm (send it as the X-API-Key header).
# The Streamlit app sends it too. Without it, those endpoints are off.
API_ACCESS_KEY=
